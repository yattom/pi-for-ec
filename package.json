{
  "name": "pi-ec-concierge",
  "version": "0.1.0",
  "description": "ECサイトでの買い物を支援するコンシェルジュ・エージェント (pi.dev 用パッケージ)",
  "type": "module",
  "license": "MIT",
  "keywords": ["pi-package", "ec", "shopping", "concierge", "japanese"],
  "pi": {
    "extensions": ["./extensions/ec-concierge/index.ts"],
    "skills": ["./skills"],
    "prompts": ["./prompts"]
  },
  "bin": {
    "ec-concierge": "./bin/ec-concierge.mjs"
  },
  "files": ["extensions", "skills", "prompts", "assets", "bin", "config", "docs", "README.md"],
  "scripts": {
    "test": "vitest --run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "concierge": "node ./bin/ec-concierge.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.3",
    "@earendil-works/pi-agent-core": "^0.84.3",
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@earendil-works/pi-tui": "^0.84.3",
    "@types/node": "22.19.19",
    "typebox": "1.3.7",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
